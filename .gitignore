# Environment variables and local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python virtual environments
.venv/
venv/
env/

# Python caches and generated files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hexgent/

# Eval 历史运行产物仅保留在本地；源码、Fixture 与 Specification 仍可跟踪。
/eval/**/runs/

# Build and package artifacts
build/
dist/
node_modules/
coverage/
*.egg-info/
.eggs/
*.tsbuildinfo

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp

# resources
resources/

# 文档默认不追踪，但上下文设计需要随实现持续维护。
docs/*
!docs/上下文管理设计.md
/frontend/next-env.d.ts

# 生成式运行证据仅保留本地；审计脚本不受这些规则影响。
/eval/**/reviews/
/eval/**/audits/**/*.json
/eval/**/audits/**/*.md
/eval/**/dry_run/
/eval/**/dry_run-*/
/eval/context_management/**/test_results.txt
/eval/context_management/**/REPORT.md
/eval/context_management/c2_prep/runner_dry_run.json
/eval/context_management/c2_prep_2/provider_trace_dry_run.json
/eval/context_management/c2_prep_2/budget_dry_run.json
