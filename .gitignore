# Environment variables and local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python virtual environments
.venv/
venv/
env/

# Python caches and generated files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hexgent/

# Eval 历史运行产物仅保留在本地；源码、Fixture 与 Specification 仍可跟踪。
/eval/**/runs/

# Build and package artifacts
build/
dist/
node_modules/
coverage/
*.egg-info/
.eggs/
*.tsbuildinfo

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp

# resources
resources/

# 文档默认不追踪，但上下文设计需要随实现持续维护。
docs/*
